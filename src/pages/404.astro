---
import "../styles/global.css";
import { content, pageHref } from "../lib/copy";
import { getPublicServices, serviceHref } from "../data/services";
import { CONTACT_EMAIL, CONTACT_MAILTO } from "../lib/contact";

const t = content.en;
const menuKeys = ["services", "projects", "domains", "about"] as const;
const publicServices = getPublicServices();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F8FAFC" />
  <meta name="robots" content="noindex,follow" />
  <meta name="description" content="The requested page could not be found on KhaiBuilds." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Page not found | KhaiBuilds</title>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="KhaiBuilds">
        <span class="brand-mark" aria-hidden="true">K</span><span>KhaiBuilds</span>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {menuKeys.map((key) => <a href={pageHref(key, "en")}>{t.nav[key]}</a>)}
      </nav>
      <div class="header-actions">
        <nav class="lang-links" aria-label={t.language}>
          <a href="/" lang="en" data-language-switch="en">EN</a>
          <span aria-hidden="true">/</span>
          <a href="/vi/" lang="vi" data-language-switch="vi">VI</a>
        </nav>
        <a class="action-button" href="/contact/">{t.contact}<span aria-hidden="true">↗</span></a>
        <details class="mobile-nav">
          <summary aria-label="Open menu"><span aria-hidden="true">☰</span></summary>
          <nav class="mobile-links" aria-label="Mobile navigation">
            {menuKeys.map((key) => <a href={pageHref(key, "en")}>{t.nav[key]}</a>)}
            {publicServices.map((item, i) => <a class:list={["mobile-sublink", i===0 && "mobile-sublink-first"]} href={serviceHref(item.slug, "en")}>{item.locales.en.cardTitle}</a>)}
            <a class="mobile-contact" href="/contact/">{t.contact} ↗</a>
          </nav>
        </details>
      </div>
    </div>
  </header>
  <main id="main">
    <div class="container">
      <section class="hero hero-inner" aria-labelledby="page-title">
        <div class="hero-body">
          <p class="eyebrow">404 · KhaiBuilds</p>
          <h1 id="page-title">Page not found</h1>
          <p class="lead">This page may have moved or does not exist. Return to the English homepage.</p>
          <div class="hero-actions"><a class="button" href="/">English homepage ↗</a></div>
          <div class="not-found-vi" lang="vi">
            <h2>Không tìm thấy trang</h2>
            <p>Trang này có thể đã được chuyển hoặc không tồn tại.</p>
            <a class="button ghost" href="/vi/">Về trang chủ tiếng Việt ↗</a>
          </div>
        </div>
      </section>
    </div>
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-brand">© {new Date().getFullYear()} KhaiBuilds</span>
      <div class="footer-secondary">
        <a class="footer-email" href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>
        <nav class="footer-links" aria-label="Legal">
          <a href="/privacy/">{t.privacy}</a>
          <a href="/terms/">{t.terms}</a>
        </nav>
      </div>
    </div>
  </footer>
  <script src="/lang.js" defer></script>
</body>
</html>
