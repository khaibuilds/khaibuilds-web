{
  "name": "@khaibuilds/web-qa-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser QA runner for mobile and desktop checks",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "qa": "node bin/qa.mjs --config qa.sample.json"
  },
  "dependencies": {
    "playwright": "1.64.1"
  }
}
